---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I’m Alfonso.</h1>
			<p>
				I’m a computer engineer, developer, musician, and technology enthusiast
				based in Seville, Spain.
			</p>
			<p>
				I write about systems, embedded development, open source, and the things
				I learn while building them.
			</p>
			<p>
				<a href="/blog">Read the blog</a> or learn more <a href="/about">about me</a>.
			</p>
			<p>
				If you're interested in my professional background, you can also check my <a href="/cv">CV</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
